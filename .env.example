POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=curry_agents
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/curry_agents
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=


API_ENV=development
API_VERSION=0.1.0
API_PREFIX=/api
API_PORT=8000


LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=["http://localhost:8088","http://127.0.0.1:8088","http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]


UI_PORT=3000
UI_API_PROXY_URL=http://api:8000/api/:path*


NGINX_PORT=8088


UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760